#!/usr/bin/env node
// Git credential helper for github.com backed by Hob's github_command_credentials tool.

import { fetchHobCredentials } from "../cli-helper.mjs";

const action = process.argv[2];
if (action !== "get") {
  process.exit(0);
}

let input = "";
process.stdin.setEncoding("utf8");
for await (const chunk of process.stdin) {
  input += chunk;
}

const fields = Object.create(null);
for (const line of input.split(/\r?\n/)) {
  if (line === "") break;
  const eq = line.indexOf("=");
  if (eq <= 0) continue;
  fields[line.slice(0, eq)] = line.slice(eq + 1);
}

const host = (fields.host || "").trim().toLowerCase();
if (host !== "github.com") {
  process.exit(0);
}

const scope = {};
if (typeof fields.path === "string" && fields.path.trim()) {
  const cleaned = fields.path.trim().replace(/^\/+/, "").replace(/\.git\/?$/, "");
  const parts = cleaned.split("/").filter(Boolean);
  if (parts.length >= 1) scope.owner = parts[0];
  if (parts.length >= 2) scope.repo = parts[1];
}

const creds = await fetchHobCredentials(scope);
if (!creds?.token) {
  process.exit(0);
}

process.stdout.write(`username=x-access-token\npassword=${creds.token}\n`);
